@@ -8,6 +8,7 @@ import (
 	"encoding/json"
 	"errors"
 	"time"
+	"unicode/utf8"
 )
 
 const GenericBody = "You have new Circula activity. Sign in to view it."
@@ -39,11 +40,25 @@ func DedupeKey(network, event, member, channel, kind string) (string, error) {
 	if network == "" || event == "" || member == "" || kind == "" || (channel != "email" && channel != "push") {
 		return "", errors.New("invalid event")
 	}
+	if !validUTF8Strings(network, event, member, channel, kind) {
+		return "", errors.New("invalid event")
+	}
 	b, _ := json.Marshal([5]string{network, event, member, channel, kind})
 	h := sha256.Sum256(b)
 	return hex.EncodeToString(h[:]), nil
 }
 
+// JSON replaces malformed UTF-8. Reject it before encoding identities or
+// private target values, while preserving every valid Unicode string.
+func validUTF8Strings(parts ...string) bool {
+	for _, part := range parts {
+		if !utf8.ValidString(part) {
+			return false
+		}
+	}
+	return true
+}
